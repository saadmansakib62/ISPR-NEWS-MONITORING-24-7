<!DOCTYPE html>
<html>
<head>
<title>ISPR Windows Desktop App</title>
<HTA:APPLICATION ID="ISPRNewsApp" APPLICATIONNAME="ISPR Daily News Report" BORDER="thick" BORDERSTYLE="normal" CAPTION="yes" MAXIMIZEBUTTON="yes" MINIMIZEBUTTON="yes" SHOWINTASKBAR="yes" SINGLEINSTANCE="yes" SYSMENU="yes" WINDOWSTATE="maximize" />
<script language="VBScript">
Sub Window_OnLoad
    Dim sh, fso, folder, targetHtml
    Set sh = CreateObject("WScript.Shell")
    Set fso = CreateObject("Scripting.FileSystemObject")
    folder = fso.GetParentFolderName(Replace(document.location.pathname, "/", "\"))
    If Left(folder, 1) = "\" Then folder = Mid(folder, 2)
    targetHtml = folder & "\ISPR_Portable_App.html"
    If Not fso.FileExists(targetHtml) Then targetHtml = folder & "\index.html"
    On Error Resume Next
    If fso.FileExists(targetHtml) Then
        sh.Run "msedge --app=""file:///" & Replace(targetHtml, "\", "/") & """ --window-size=1420,880", 1, False
    Else
        sh.Run "msedge --app=""https://isprbdnewsreport.netlify.app/"" --window-size=1420,880", 1, False
    End If
    window.close
End Sub
</script>
</head>
<body style="background:#020617;color:#10b981;font-family:sans-serif;padding:40px;text-align:center;">
<h3>Launching ISPR Desktop Application...</h3>
</body>
</html>